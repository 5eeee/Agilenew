generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  LLC
  JSC
  SOLE_PROPRIETOR
  SELF_EMPLOYED
  STARTUP
  INDIVIDUAL
}

enum CompanyRole {
  OWNER
  ADMIN
  EMPLOYEE
}

enum ChannelType {
  DIRECT
  GROUP
  COMPANY
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
}

enum OrderStatus {
  NEW
  DISCOVERY
  PLANNING
  DESIGN
  DEVELOPMENT
  QA
  LAUNCH
  SUPPORT
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarData   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  memberships    CompanyMember[]
  companies      Company[]         @relation("CompanyOwner")
  participants   ChatParticipant[]
  messages       ChatMessage[]
  channels       ChatChannel[]     @relation("ChannelCreator")
  vaultProjects  VaultProject[]    @relation("VaultProjectOwner")
  vaultItems     VaultItem[]       @relation("VaultItemCreator")
  callsMade      Call[]            @relation("CallCaller")
  callsReceived  Call[]            @relation("CallCallee")
  callSignals    CallSignal[]
  contacts       Contact[]
  tasks          Task[]
  leads          Lead[]
  serviceOrders  ServiceOrder[]
  projectReviews ProjectReview[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id        String          @id @default(uuid())
  name      String
  type      CompanyType
  ownerId   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  owner     User            @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   CompanyMember[]
  channels  ChatChannel[]
  vaults    VaultProject[]

  @@index([ownerId])
}

model CompanyMember {
  companyId String
  userId    String
  role      CompanyRole @default(EMPLOYEE)
  joinedAt  DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
}

model ChatChannel {
  id           String            @id @default(uuid())
  name         String
  type         ChannelType
  companyId    String?
  createdById  String
  createdAt    DateTime          @default(now())
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([companyId])
}

model ChatParticipant {
  channelId String
  userId    String
  joinedAt  DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(uuid())
  channelId  String
  senderId   String
  ciphertext String
  iv         String
  version    Int         @default(1)
  createdAt  DateTime    @default(now())
  editedAt   DateTime?
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([channelId, createdAt])
}

model VaultProject {
  id             String      @id @default(uuid())
  ownerId        String
  companyId      String?
  nameCiphertext String
  nameIv         String
  kdfSalt        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  owner          User        @relation("VaultProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  company        Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items          VaultItem[]

  @@index([ownerId])
  @@index([companyId])
}

model VaultItem {
  id                String       @id @default(uuid())
  projectId         String
  createdById       String
  kind              String
  titleCiphertext   String
  titleIv           String
  payloadCiphertext String
  payloadIv         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           VaultProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User         @relation("VaultItemCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId])
}

model Call {
  id         String       @id @default(uuid())
  callerId   String
  calleeId   String
  status     CallStatus   @default(RINGING)
  video      Boolean      @default(false)
  createdAt  DateTime     @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  caller     User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  signals    CallSignal[]

  @@index([calleeId, status])
}

model CallSignal {
  id        String   @id @default(uuid())
  callId    String
  senderId  String
  type      String
  payload   Json
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Task {
  id          String    @id @default(uuid())
  ownerId     String
  title       String
  description String?
  status      String    @default("ACTIVE")
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

model Lead {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  source    String   @default("site")
  status    String   @default("new")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model ServiceOrder {
  id             String               @id @default(uuid())
  userId         String
  name           String
  status         OrderStatus          @default(NEW)
  paymentStatus  PaymentStatus        @default(PENDING)
  total          Int
  currency       String               @default("RUB")
  locale         String               @default("ru")
  projectSlug    String?              @unique
  publicTitle    String?
  publicSummary  String?              @db.Text
  publishedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          ServiceOrderItem[]
  stageApprovals OrderStageApproval[]
  review         ProjectReview?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([publishedAt])
}

model OrderStageApproval {
  id                 String       @id @default(uuid())
  orderId            String
  stage              OrderStatus
  executorApprovedAt DateTime?
  clientApprovedAt   DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  order              ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, stage])
  @@index([orderId, createdAt])
}

model ProjectReview {
  id          String       @id @default(uuid())
  orderId     String       @unique
  userId      String
  rating      Int
  text        String       @db.Text
  publicText  String?      @db.Text
  clientRole  String?
  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, publishedAt])
}

model ServiceOrderItem {
  id        String       @id @default(uuid())
  orderId   String
  serviceId String
  title     String
  price     Int
  quantity  Int          @default(1)
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
