# Optional local overrides (all use AGILE_ prefix)
# AGILE_WEB_URL=http://127.0.0.1:8081
# AGILE_CONTENT_URL=http://127.0.0.1:8082
# AGILE_LEADS_URL=http://127.0.0.1:8083
# AGILE_GATEWAY_PORT=8091
# AGILE_LEADS_INTERNAL_URL=http://127.0.0.1:8083/api/v1/leads

# PostgreSQL used by accounts, personal cabinet, projects and leads
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Corporate email notifications (copy this file to .env and fill locally)
# AGILE_SMTP_HOST=smtp.mail.ru
# AGILE_SMTP_PORT=465
# AGILE_SMTP_SECURE=true
# AGILE_SMTP_USER=info@agile-business-pro.com
# AGILE_SMTP_PASS=replace-with-app-password
# AGILE_EMAIL_FROM=info@agile-business-pro.com
# AGILE_EMAIL_TO=info@agile-business-pro.com

# Optional token for private GET /api/leads access
# AGILE_LEADS_READ_TOKEN=replace-with-long-random-token
# AGILE_AUTH_SECRET=replace-with-a-long-random-production-secret
